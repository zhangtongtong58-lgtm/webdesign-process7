{
  "name": "@opensig/opendesign-token",
  "version": "0.0.11",
  "description": "Theme tokens for opendesign design system",
  "type": "module",
  "files": [
    "themes",
    "tokens",
    "fonts",
    "code-snippets"
  ],
  "devDependencies": {
    "@opensig/open-scripts": "1.0.6",
    "@types/node": "^22.13.1",
    "typescript": "^5.8.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "bugs": "https://atomgit.com/openeuler/opendesign-token/issues",
  "homepage": "",
  "repository": {
    "type": "git",
    "url": "https://atomgit.com/openeuler/opendesign-token.git"
  },
  "scripts": {
    "build:a": "open-scripts gen:token --config ./configs/ascend.token.config.ts",
    "build:k": "open-scripts gen:token --config ./configs/kunpeng.token.config.ts",
    "build:e": "open-scripts gen:token --config ./configs/openEuler.token.config.ts",
    "build:g": "open-scripts gen:token --config ./configs/openGauss.token.config.ts",
    "build:u": "open-scripts gen:token --config ./configs/openUbmc.token.config.ts",
    "build:m": "open-scripts gen:token --config ./configs/mindspore.token.config.ts",
    "build:all": "pnpm build:a && pnpm build:k && pnpm build:e && pnpm build:g && pnpm build:u && pnpm build:m && node ./scripts/inject-responsive.js",
    "release": "pnpm publish --registry https://registry.npmjs.org"
  }
}