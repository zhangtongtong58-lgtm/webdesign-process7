{
  "Grid Container": {
    "prefix": "grid-container",
    "body": [
      "<div class=\"o-r-grid-container\">",
      "  $0",
      "</div>"
    ],
    "description": "生成栅格容器基础结构"
  },
  "Grid Column Width Variable": {
    "prefix": "grid-column-var",
    "body": [
      "width: var(--o-r-grid-${1:1});"
    ],
    "description": "使用栅格列宽CSS变量（替换数字为需要的列数）"
  },
  "Grid Full Width Variable": {
    "prefix": "grid-full-var",
    "body": [
      "width: var(--o-r-grid-full);"
    ],
    "description": "使用栅格全宽CSS变量"
  },
  "Grid Column Gutter Variable": {
    "prefix": "grid-gutter-var",
    "body": [
      "margin-right: var(--o-r-grid-column-gutter);"
    ],
    "description": "使用栅格水槽宽度CSS变量"
  }
}